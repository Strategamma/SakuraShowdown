{
  "name": "Sakura Showdown",
  "short_name": "Sakura",
  "description": "A mobile-first tactical duel for offline, pass-and-play, and private same-Wi-Fi matches.",
  "id": "./",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0d0c0c",
  "theme_color": "#0d0c0c",
  "categories": ["games", "entertainment"],
  "icons": [
    { "src": "./sakura-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./sakura-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./sakura-icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Play Solo",
      "short_name": "Solo",
      "url": "./?source=pwa&play=solo",
      "icons": [{ "src": "./sakura-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Same Wi-Fi",
      "short_name": "Wi-Fi",
      "url": "./?source=pwa&play=together",
      "icons": [{ "src": "./sakura-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
